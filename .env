# .env.example  -> Copie para .env e preencha os valores reais (NUNCA commit com valores reais)
PORT=3000
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_USER=trust
DB_PASS=trust8462
DB_NAME=db
DB_CONN_LIMIT=10

# URL do front-end (coloque a URL pública do seu site; em dev pode ser http://localhost:5500)
